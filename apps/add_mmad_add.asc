#include "device_kernels.h"
#include "test_support.h"

int main()
{
    try {
        constexpr size_t aCount = lab::kM * lab::kK;
        constexpr size_t bCount = lab::kK * lab::kN;
        constexpr size_t cCount = lab::kM * lab::kN;
        auto a0 = lab::MakeInput(aCount, 4);
        auto a1 = lab::MakeInput(aCount, 5);
        auto b = lab::MakeRectangularIdentity();
        auto addend = lab::MakeInput(cCount, 6);
        std::vector<aclFloat16> output(cCount);
        std::vector<float> expected(cCount);
        for (uint32_t row = 0; row < lab::kM; ++row) {
            for (uint32_t col = 0; col < lab::kN; ++col) {
                const size_t cIndex = row * lab::kN + col;
                expected[cIndex] = lab::Float(addend[cIndex]);
                if (col < lab::kK) {
                    const size_t aIndex = row * lab::kK + col;
                    expected[cIndex] += lab::Float(a0[aIndex]) + lab::Float(a1[aIndex]);
                }
            }
        }

        lab::Runtime runtime;
        lab::DeviceBuffer a0Device(aCount * sizeof(aclFloat16));
        lab::DeviceBuffer a1Device(aCount * sizeof(aclFloat16));
        lab::DeviceBuffer aSumDevice(aCount * sizeof(aclFloat16));
        lab::DeviceBuffer bDevice(bCount * sizeof(aclFloat16));
        lab::DeviceBuffer mmDevice(cCount * sizeof(aclFloat16));
        lab::DeviceBuffer addendDevice(cCount * sizeof(aclFloat16));
        lab::DeviceBuffer outputDevice(cCount * sizeof(aclFloat16));
        a0Device.CopyFrom(a0.data());
        a1Device.CopyFrom(a1.data());
        bDevice.CopyFrom(b.data());
        addendDevice.CopyFrom(addend.data());

        // One MIX launch: AIV pre-add, AIC MMAD, then AIV post-add, synchronized inside each logical AI Core.
        lab::AddMmadAddKernel<
            lab::kM, lab::kK, lab::kN, lab::kSingleCoreM, lab::kBaseM, lab::kBaseK, lab::kBaseN>
            <<<lab::kM / lab::kSingleCoreM, 0, runtime.stream()>>>(
                a0Device.data(), a1Device.data(), bDevice.data(), addendDevice.data(), aSumDevice.data(),
                mmDevice.data(), outputDevice.data());
        runtime.Sync();
        outputDevice.CopyTo(output.data());
        return lab::Verify(output, expected, 3.0e-2f, "add_mmad_add") ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "add_mmad_add: " << error.what() << '\n';
        return 1;
    }
}
