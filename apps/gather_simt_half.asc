#include <cmath>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/asc_fp16.h"
#include "half_utils.h"

constexpr uint32_t kN = 4096;
constexpr uint32_t kThreads = 256;

// SIMT half gather: out[i] = src[index[i]].
__global__ void GatherSimtHalfKernel(half* src, uint32_t* index, half* out, uint64_t length)
{
    for (uint64_t i = blockIdx.x * blockDim.x + threadIdx.x; i < length; i += blockDim.x * gridDim.x) {
        out[i] = src[index[i]];
    }
}

int main()
{
    try {
        constexpr size_t dataBytes = kN * sizeof(uint16_t);
        constexpr size_t idxBytes = kN * sizeof(uint32_t);
        std::vector<uint16_t> src(kN);
        std::vector<uint32_t> index(kN);
        std::vector<uint16_t> out(kN);
        std::vector<float> expected(kN);
        for (uint32_t i = 0; i < kN; ++i) {
            src[i] = lab::F16(0.5f + static_cast<float>(i % 97) * 0.25f);
            index[i] = kN - 1 - i;
        }
        for (uint32_t i = 0; i < kN; ++i) {
            expected[i] = lab::F32(src[kN - 1 - i]);
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        half* srcDev = nullptr;
        uint32_t* idxDev = nullptr;
        half* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&srcDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&idxDev), idxBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(srcDev, dataBytes, src.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(idxDev, idxBytes, index.data(), idxBytes, ACL_MEMCPY_HOST_TO_DEVICE);

        GatherSimtHalfKernel<<<1, kThreads, 0, stream>>>(srcDev, idxDev, outDev, kN);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), dataBytes, outDev, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kN; ++i) {
            if (std::fabs(lab::F32(out[i]) - expected[i]) > 1.0e-3f) {
                std::cerr << "gather_simt_half mismatch at " << i << ": expected " << expected[i] << ", got "
                          << lab::F32(out[i]) << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(srcDev);
        aclrtFree(idxDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "gather_simt_half: " << (ok ? "PASS" : "FAIL") << " (" << kN << " elements)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "gather_simt_half: " << error.what() << '\n';
        return 1;
    }
}
