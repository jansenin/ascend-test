#include <cmath>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

// Stream-compaction SIMD branch benchmark (low-level RegBase only), v2.
//
//   y = (x < threshold) ? contract(x) : x,   contract(e) = e*0.5+0.5 (x64)
//
// v1 compacted BOTH the rare values and the rare positions (two forward
// passes). v2 compacts POSITIONS ONLY, then uses the hardware register
// gather/scatter (vgather2/vscatter) to move the values. This:
//   - "merges" the two forward passes into one (the shared AR register makes
//     a literal interleave of value+position Squeeze<STORE_REG> wrong, so we
//     drop the value compaction entirely instead);
//   - generalizes to >64 rare elements by looping over compact chunks.
//
// argv[1]: "sparse" (default, ~1% rare) or "dense" (every 8th element rare,
//   >64 rare so the chunked loop is exercised).

constexpr uint32_t kLength = 4096;
constexpr float kThreshold = 0.01f;
constexpr uint32_t kExpensiveK = 64;

// Pass 1: globally compact the rare POSITIONS (1-based element index, so a
// zeroed lane is distinguishable from valid position 0).
template <uint32_t Length>
__simd_vf__ inline void CompactPositionsVF(__ubuf__ float* in, __ubuf__ uint32_t* pos,
                                           __ubuf__ uint32_t* compactPos)
{
    constexpr uint32_t epv = AscendC::GetVecLen() / sizeof(float);
    constexpr uint32_t numVec = Length / epv;

    AscendC::Reg::RegTensor<float> vr;
    AscendC::Reg::RegTensor<uint32_t> posReg, cPos;
    AscendC::Reg::MaskReg rare, full;
    AscendC::Reg::UnalignRegForStore ureg;

    full = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::ClearSpr<AscendC::SpecialPurposeReg::AR>();
    for (uint32_t i = 0; i < numVec; ++i) {
        AscendC::Reg::LoadAlign(vr, in + i * epv);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(rare, vr, kThreshold, full);
        AscendC::Reg::LoadAlign(posReg, pos + i * epv);
        AscendC::Reg::Squeeze<uint32_t, AscendC::Reg::GatherMaskMode::STORE_REG>(cPos, posReg, rare);
        AscendC::Reg::StoreUnAlign<uint32_t, AscendC::Reg::PostLiteral::POST_MODE_UPDATE>(compactPos, cPos, ureg);
    }
    AscendC::Reg::StoreUnAlignPost(compactPos, ureg);
}

// Pass 2: copy in->out (non-rare lanes keep their value), then gather the
// rare values, contract them, and scatter back. Chunked so any rare count is
// handled (not just <= 64).
template <uint32_t Length>
__simd_vf__ inline void GatherOperateScatterVF(__ubuf__ float* in, __ubuf__ float* out,
                                               __ubuf__ uint32_t* compactPos, uint32_t rareCount)
{
    constexpr uint32_t epv = AscendC::GetVecLen() / sizeof(float);
    constexpr uint32_t numVec = Length / epv;

    AscendC::Reg::RegTensor<float> vr, vals;
    AscendC::Reg::RegTensor<uint32_t> cPos;
    AscendC::Reg::MaskReg full, valid;

    full = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();

    for (uint32_t i = 0; i < numVec; ++i) {
        AscendC::Reg::LoadAlign(vr, in + i * epv);
        AscendC::Reg::StoreAlign(out + i * epv, vr, full);
    }

    uint32_t chunks = (rareCount + epv - 1) / epv;
    for (uint32_t c = 0; c < chunks; ++c) {
        AscendC::Reg::LoadAlign(cPos, compactPos + c * epv);
        AscendC::Reg::Compares<uint32_t, AscendC::CMPMODE::GT>(valid, cPos, 0, full);
        AscendC::Reg::Adds<uint32_t>(cPos, cPos, 0xFFFFFFFFu, full); // -1 -> 0-based
        AscendC::Reg::Gather(vals, in, cPos, valid);
        for (uint32_t k = 0; k < kExpensiveK; ++k) {
            AscendC::Reg::Muls(vals, vals, 0.5f, full);
            AscendC::Reg::Adds(vals, vals, 0.5f, full);
        }
        AscendC::Reg::Scatter(out, vals, cPos, valid);
    }
}

// rareCount is passed from the host, which already computes it while building
// the reference. The on-device equivalent is AscendC::GetSpr<AscendC::
// SpecialPurposeReg::AR>() (callable from this __global__ __vector__ body, NOT
// from inside a __simd_vf__), which returns the compacted element count after
// Squeeze<STORE_REG>. Reading it is a single scalar register read (get_ar)
// executed once between the two VF calls, so there is no meaningful overhead
// and it would make this kernel fully self-contained. We keep host-passing for
// simplicity; swap it for GetSpr<AR>() if the kernel must derive rareCount
// itself.
__global__ __vector__ void BranchCompactSimdKernel(__gm__ float* in, __gm__ uint32_t* pos, __gm__ float* out,
                                                   uint32_t rareCount)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> inGm;
    AscendC::GlobalTensor<uint32_t> posGm;
    AscendC::GlobalTensor<float> outGm;
    inGm.SetGlobalBuffer(in, kLength);
    posGm.SetGlobalBuffer(pos, kLength);
    outGm.SetGlobalBuffer(out, kLength);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    auto inLocal = allocator.Alloc<float, kLength>();
    auto posLocal = allocator.Alloc<uint32_t, kLength>();
    auto outLocal = allocator.Alloc<float, kLength>();
    auto compactPos = allocator.Alloc<uint32_t, kLength>();

    AscendC::DataCopy(inLocal, inGm, kLength);
    AscendC::DataCopy(posLocal, posGm, kLength);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    asc_vf_call<CompactPositionsVF<kLength>>(
        reinterpret_cast<__ubuf__ float*>(inLocal.GetPhyAddr()),
        reinterpret_cast<__ubuf__ uint32_t*>(posLocal.GetPhyAddr()),
        reinterpret_cast<__ubuf__ uint32_t*>(compactPos.GetPhyAddr()));

    asc_vf_call<GatherOperateScatterVF<kLength>>(
        reinterpret_cast<__ubuf__ float*>(inLocal.GetPhyAddr()),
        reinterpret_cast<__ubuf__ float*>(outLocal.GetPhyAddr()),
        reinterpret_cast<__ubuf__ uint32_t*>(compactPos.GetPhyAddr()),
        rareCount);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(outGm, outLocal, kLength);
    AscendC::PipeBarrier<PIPE_ALL>();
}

static float Contract(float e)
{
    for (uint32_t k = 0; k < kExpensiveK; ++k) {
        e = e * 0.5f + 0.5f;
    }
    return e;
}

int main(int argc, char* argv[])
{
    std::string mode = (argc > 1) ? argv[1] : "sparse";
    bool dense = (mode == "dense");
    if (mode != "sparse" && mode != "dense") {
        std::cerr << "branch_simd_compact: mode must be 'sparse' or 'dense'\n";
        return 2;
    }

    try {
        std::vector<float> in(kLength);
        std::vector<uint32_t> pos(kLength); // 1-based element index
        std::vector<float> out(kLength);
        std::vector<float> expected(kLength);

        uint32_t rareCount = 0;
        for (uint32_t i = 0; i < kLength; ++i) {
            if (dense) {
                in[i] = (i % 8 == 0) ? 0.001f : 0.5f + static_cast<float>(i % 97) * 0.25f;
            } else {
                in[i] = (i % 100 == 0) ? 0.001f : 0.5f + static_cast<float>(i % 97) * 0.25f;
            }
            pos[i] = i + 1;
            if (in[i] < kThreshold) ++rareCount;
        }
        for (uint32_t i = 0; i < kLength; ++i) {
            expected[i] = (in[i] < kThreshold) ? Contract(in[i]) : in[i];
        }

        constexpr size_t dataBytes = kLength * sizeof(float);
        constexpr size_t posBytes = kLength * sizeof(uint32_t);

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        float* inDev = nullptr;
        uint32_t* posDev = nullptr;
        float* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&inDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&posDev), posBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(inDev, dataBytes, in.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(posDev, posBytes, pos.data(), posBytes, ACL_MEMCPY_HOST_TO_DEVICE);

        BranchCompactSimdKernel<<<1, 0, stream>>>(inDev, posDev, outDev, rareCount);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), dataBytes, outDev, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kLength; ++i) {
            if (out[i] != expected[i]) {
                std::cerr << "branch_simd_compact[" << mode << "] mismatch at " << i << ": expected " << expected[i]
                          << ", got " << out[i] << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(inDev);
        aclrtFree(posDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "branch_simd_compact[" << mode << "]: " << (ok ? "PASS" : "FAIL") << " (" << kLength
                  << " elems, " << rareCount << " rare, " << kExpensiveK << " iters)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "branch_simd_compact: " << error.what() << '\n';
        return 1;
    }
}
