#include "device_kernels.h"
#include "test_support.h"

int main()
{
    try {
        constexpr size_t count = lab::kM * lab::kK;
        constexpr size_t bytes = count * sizeof(aclFloat16);
        auto lhs = lab::MakeInput(count, 1);
        auto rhs = lab::MakeInput(count, 2);
        std::vector<aclFloat16> output(count);
        std::vector<float> expected(count);
        for (size_t i = 0; i < count; ++i) {
            expected[i] = lab::Float(lhs[i]) + lab::Float(rhs[i]);
        }

        lab::Runtime runtime;
        lab::DeviceBuffer lhsDevice(bytes);
        lab::DeviceBuffer rhsDevice(bytes);
        lab::DeviceBuffer outputDevice(bytes);
        lhsDevice.CopyFrom(lhs.data());
        rhsDevice.CopyFrom(rhs.data());
        lab::AddKernel<lab::kAddTile><<<count / lab::kAddTile, 0, runtime.stream()>>>(
            lhsDevice.data(), rhsDevice.data(), outputDevice.data());
        runtime.Sync();
        outputDevice.CopyTo(output.data());
        return lab::Verify(output, expected, 2.0e-3f, "vector_add") ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "vector_add: " << error.what() << '\n';
        return 1;
    }
}
