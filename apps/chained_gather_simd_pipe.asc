#include <algorithm>
#include <cmath>
#include <cstdint>
#include <iostream>
#include <random>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

// Chained-gather benchmark, SIMD, SOFTWARE-PIPELINED.
//
// Same problem as chained_gather_simd.asc (4 dependent gather levels per
// chunk), but the 4 gathers issued in a single loop iteration operate on
// DIFFERENT chunks / buffers, so within an iteration there is no RAW hazard
// and the vector pipe can overlap them instead of stalling on the dependency.
//
// Naive (dependent) order per chunk:   g1_0 g2_0 g3_0 g4_0  g1_1 g2_1 ...
// Pipelined (diagonal) order:          g1_0
//                                       g1_1 g2_0
//                                       g1_2 g2_1 g3_0
//                                       g1_3 g2_2 g3_1 g4_0   <- steady state
//                                          ... (loop)
//                                       g2_N g3_(N-1) g4_(N-2)  <- tail
//
// Level L of chunk c reads buffer (L-1)[c%4]; it was written one step earlier,
// so consecutive gathers within one step never touch the same buffer. This
// needs 4x the intermediate buffers (one per level per pipeline stage).

constexpr uint32_t kChunk = 128;
constexpr uint32_t kNumChunks = 8;
constexpr uint32_t kTotal = kChunk * kNumChunks; // 1024 source elements
constexpr uint32_t kLevels = 4;                  // gather chain depth = pipeline depth
constexpr uint32_t kRepeats = 8;                 // amortize launch/prologue overhead

__global__ __vector__ void ChainedGatherSimdPipeKernel(
    __gm__ float* src, __gm__ uint32_t* index, __gm__ float* out)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<uint32_t> idxGm;
    AscendC::GlobalTensor<float> outGm;
    srcGm.SetGlobalBuffer(src, kTotal);
    idxGm.SetGlobalBuffer(index, kChunk);
    outGm.SetGlobalBuffer(out, kTotal);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    auto srcLocal = allocator.Alloc<float, kTotal>();
    auto idxLocal = allocator.Alloc<uint32_t, kChunk>();
    AscendC::LocalTensor<float> a1[kLevels];
    AscendC::LocalTensor<float> a2[kLevels];
    AscendC::LocalTensor<float> a3[kLevels];
    AscendC::LocalTensor<float> a4[kLevels];
    for (uint32_t b = 0; b < kLevels; ++b) {
        a1[b] = allocator.Alloc<float, kChunk>();
        a2[b] = allocator.Alloc<float, kChunk>();
        a3[b] = allocator.Alloc<float, kChunk>();
        a4[b] = allocator.Alloc<float, kChunk>();
    }

    // Load everything once: all chunks + the index array.
    AscendC::DataCopy(srcLocal, srcGm, kTotal);
    AscendC::DataCopy(idxLocal, idxGm, kChunk);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    for (uint32_t r = 0; r < kRepeats; ++r) {
        // Diagonal software pipeline. Step s issues gather level L for chunk
        // c = s - (L-1), for L = 1..kLevels, skipping out-of-range chunks.
        for (uint32_t s = 0; s < kNumChunks + kLevels - 1; ++s) {
            for (uint32_t L = 1; L <= kLevels; ++L) {
                if (L - 1 > s) {
                    break; // chunk index would be negative; larger L even more so
                }
                uint32_t c = s - (L - 1);
                if (c >= kNumChunks) {
                    continue; // chunk past the end; smaller L only
                }
                uint32_t b = c % kLevels; // rotating buffer
                switch (L) {
                    case 1:
                        // Gather offsets are BYTE addresses relative to the base offset.
                        AscendC::Gather(a1[b], srcLocal, idxLocal, c * kChunk * sizeof(float), kChunk);
                        break;
                    case 2:
                        AscendC::Gather(a2[b], a1[b], idxLocal, 0, kChunk);
                        break;
                    case 3:
                        AscendC::Gather(a3[b], a2[b], idxLocal, 0, kChunk);
                        break;
                    case 4:
                        AscendC::Gather(a4[b], a3[b], idxLocal, 0, kChunk);
                        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                        AscendC::DataCopy(outGm[c * kChunk], a4[b], kChunk);
                        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                        break;
                }
            }
        }
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main(int argc, char* argv[])
{
    std::string variant = (argc > 1) ? argv[1] : "random";
    bool perm = (variant == "perm");
    if (variant != "random" && variant != "perm") {
        std::cerr << "chained_gather_simd_pipe: variant must be 'random' or 'perm'\n";
        return 2;
    }

    try {
        constexpr size_t dataBytes = kTotal * sizeof(float);
        constexpr size_t idxBytes = kChunk * sizeof(uint32_t);
        std::vector<float> src(kTotal);
        std::vector<uint32_t> index(kChunk);     // element index in [0,kChunk)
        std::vector<uint32_t> byteIndex(kChunk); // device gather offset (BYTE address)
        std::vector<float> out(kTotal);
        std::vector<float> expected(kTotal);

        for (uint32_t i = 0; i < kTotal; ++i) {
            src[i] = 0.5f + static_cast<float>(i % 97) * 0.25f;
        }
        std::mt19937 gen(42);
        if (perm) {
            for (uint32_t i = 0; i < kChunk; ++i) {
                index[i] = i;
            }
            std::shuffle(index.begin(), index.end(), gen);
        } else {
            std::uniform_int_distribution<uint32_t> dist(0, kChunk - 1);
            for (uint32_t i = 0; i < kChunk; ++i) {
                index[i] = dist(gen);
            }
        }
        for (uint32_t i = 0; i < kChunk; ++i) {
            byteIndex[i] = index[i] * sizeof(float);
        }

        // Expected: four applications of the index mapping to each chunk.
        for (uint32_t c = 0; c < kNumChunks; ++c) {
            for (uint32_t i = 0; i < kChunk; ++i) {
                uint32_t e = i;
                for (uint32_t l = 0; l < kLevels; ++l) {
                    e = index[e];
                }
                expected[c * kChunk + i] = src[c * kChunk + e];
            }
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        float* srcDev = nullptr;
        uint32_t* idxDev = nullptr;
        float* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&srcDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&idxDev), idxBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(srcDev, dataBytes, src.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(idxDev, idxBytes, byteIndex.data(), idxBytes, ACL_MEMCPY_HOST_TO_DEVICE);

        ChainedGatherSimdPipeKernel<<<1, 0, stream>>>(srcDev, idxDev, outDev);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), dataBytes, outDev, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kTotal; ++i) {
            if (out[i] != expected[i]) {
                std::cerr << "chained_gather_simd_pipe[" << variant << "] mismatch at " << i
                          << ": expected " << expected[i] << ", got " << out[i] << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(srcDev);
        aclrtFree(idxDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "chained_gather_simd_pipe[" << variant << "]: " << (ok ? "PASS" : "FAIL") << " ("
                  << kTotal << " elems x " << kLevels << " levels)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "chained_gather_simd_pipe: " << error.what() << '\n';
        return 1;
    }
}
