#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <random>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

// Chained-gather benchmark (SIMT).
//
// One block per chunk (kChunk=128 threads), grid = kNumChunks blocks. Each
// gather level depends on the previous one, so the intermediate arrays live
// in shared memory (UB) and are separated by full-block barriers:
//   a1 = gather(chunk, idx)
//   a2 = gather(a1, idx)
//   a3 = gather(a2, idx)
//   a4 = gather(a3, idx)   -> written to GM
//
// argv[1]: "random" (repeats allowed) or "perm" (permutation of 0..kChunk-1).
// argv[2] (optional): repeat count (default 8).
// argv[3] (optional): "nosync" to drop the asc_syncthreads() barriers (this is
//                     a correctness experiment: without barriers the cross-thread
//                     shared-memory gather is a data race).

constexpr uint32_t kChunk = 128;
constexpr uint32_t kNumChunks = 8;
constexpr uint32_t kTotal = kChunk * kNumChunks;
constexpr uint32_t kLevels = 4;
constexpr uint32_t kThreads = kChunk;

// kSync=false removes the full-block barriers between gather levels. Each
// level reads smem[...][idx] where idx = index[pos] is another thread's slot,
// so the barriers are required for correctness on hardware; the no-sync
// variant is only meaningful as a race-condition demonstration.
template <bool kSync>
__global__ __launch_bounds__(kThreads) void ChainedGatherSimtKernel(
    float* src, uint32_t* index, float* out, uint32_t repeats)
{
    extern __ubuf__ float smem[]; // [0,128)=a1 [128,256)=a2 [256,384)=a3
    uint32_t pos = threadIdx.x;
    uint32_t idx = index[pos]; // element index in [0, kChunk)

    // Single block (one AIV), looping over chunks: fair single-core
    // comparison against the SIMD kernel, which also uses one block.
    for (uint32_t r = 0; r < repeats; ++r) {
        for (uint32_t chunk = 0; chunk < kNumChunks; ++chunk) {
            smem[0 * kChunk + pos] = src[chunk * kChunk + idx];
            if (kSync) asc_syncthreads();
            smem[1 * kChunk + pos] = smem[0 * kChunk + idx];
            if (kSync) asc_syncthreads();
            smem[2 * kChunk + pos] = smem[1 * kChunk + idx];
            if (kSync) asc_syncthreads();
            out[chunk * kChunk + pos] = smem[2 * kChunk + idx];
        }
    }
}

int main(int argc, char* argv[])
{
    std::string variant = (argc > 1) ? argv[1] : "random";
    bool perm = (variant == "perm");
    if (variant != "random" && variant != "perm") {
        std::cerr << "chained_gather_simt: variant must be 'random' or 'perm'\n";
        return 2;
    }
    uint32_t repeats = 8;
    if (argc > 2) {
        repeats = static_cast<uint32_t>(std::strtoul(argv[2], nullptr, 10));
        if (repeats == 0) repeats = 1;
    }
    bool sync = true;
    if (argc > 3 && std::string(argv[3]) == "nosync") sync = false;

    try {
        constexpr size_t dataBytes = kTotal * sizeof(float);
        constexpr size_t idxBytes = kChunk * sizeof(uint32_t);
        std::vector<float> src(kTotal);
        std::vector<uint32_t> index(kChunk); // element index in [0,kChunk)
        std::vector<float> out(kTotal);
        std::vector<float> expected(kTotal);

        for (uint32_t i = 0; i < kTotal; ++i) {
            src[i] = 0.5f + static_cast<float>(i % 97) * 0.25f;
        }
        std::mt19937 gen(42);
        if (perm) {
            for (uint32_t i = 0; i < kChunk; ++i) {
                index[i] = i;
            }
            std::shuffle(index.begin(), index.end(), gen);
        } else {
            std::uniform_int_distribution<uint32_t> dist(0, kChunk - 1);
            for (uint32_t i = 0; i < kChunk; ++i) {
                index[i] = dist(gen);
            }
        }

        for (uint32_t c = 0; c < kNumChunks; ++c) {
            for (uint32_t i = 0; i < kChunk; ++i) {
                uint32_t e = i;
                for (uint32_t l = 0; l < kLevels; ++l) {
                    e = index[e];
                }
                expected[c * kChunk + i] = src[c * kChunk + e];
            }
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        float* srcDev = nullptr;
        uint32_t* idxDev = nullptr;
        float* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&srcDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&idxDev), idxBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(srcDev, dataBytes, src.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(idxDev, idxBytes, index.data(), idxBytes, ACL_MEMCPY_HOST_TO_DEVICE);

        // Shared memory: 3 levels x 128 floats. dyn_ubuf_size is in 32-byte units.
        constexpr uint32_t dynUbSize = (kLevels - 1) * kChunk * sizeof(float) / 32;
        if (sync) {
            ChainedGatherSimtKernel<true><<<1, kThreads, dynUbSize, stream>>>(srcDev, idxDev, outDev, repeats);
        } else {
            ChainedGatherSimtKernel<false><<<1, kThreads, dynUbSize, stream>>>(srcDev, idxDev, outDev, repeats);
        }
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), dataBytes, outDev, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kTotal; ++i) {
            if (out[i] != expected[i]) {
                std::cerr << "chained_gather_simt[" << variant << "] mismatch at " << i << ": expected "
                          << expected[i] << ", got " << out[i] << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(srcDev);
        aclrtFree(idxDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "chained_gather_simt[" << variant << (sync ? "" : ",nosync") << "]: " << (ok ? "PASS" : "FAIL")
                  << " (" << kTotal << " elems x " << kLevels << " levels)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "chained_gather_simt: " << error.what() << '\n';
        return 1;
    }
}
