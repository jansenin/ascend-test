#include <cmath>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

constexpr uint32_t kN = 4096;
constexpr uint32_t kThreads = 256;

// SIMT scatter: dst[index[i]] = src[i].
__global__ void ScatterSimtKernel(float* src, uint32_t* index, float* dst, uint64_t length)
{
    for (uint64_t i = blockIdx.x * blockDim.x + threadIdx.x; i < length; i += blockDim.x * gridDim.x) {
        dst[index[i]] = src[i];
    }
}

int main()
{
    try {
        constexpr size_t dataBytes = kN * sizeof(float);
        constexpr size_t idxBytes = kN * sizeof(uint32_t);
        std::vector<float> src(kN);
        std::vector<uint32_t> index(kN);
        std::vector<float> dst(kN);
        std::vector<float> expected(kN, 0.0f);
        for (uint32_t i = 0; i < kN; ++i) {
            src[i] = 0.5f + static_cast<float>(i % 97) * 0.25f;
            index[i] = kN - 1 - i;
        }
        for (uint32_t i = 0; i < kN; ++i) {
            expected[index[i]] = src[i];
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        float* srcDev = nullptr;
        uint32_t* idxDev = nullptr;
        float* dstDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&srcDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&idxDev), idxBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&dstDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(srcDev, dataBytes, src.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(idxDev, idxBytes, index.data(), idxBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemset(dstDev, dataBytes, 0, dataBytes);

        ScatterSimtKernel<<<1, kThreads, 0, stream>>>(srcDev, idxDev, dstDev, kN);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dst.data(), dataBytes, dstDev, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kN; ++i) {
            if (dst[i] != expected[i]) {
                std::cerr << "scatter_simt mismatch at " << i << ": expected " << expected[i] << ", got " << dst[i]
                          << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(srcDev);
        aclrtFree(idxDev);
        aclrtFree(dstDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "scatter_simt: " << (ok ? "PASS" : "FAIL") << " (" << kN << " elements)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "scatter_simt: " << error.what() << '\n';
        return 1;
    }
}
