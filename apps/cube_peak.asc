#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "half_utils.h"

// cube peak benchmark: single core, B static (weights resident in L0B), A streamed
// (NUM_MMADS tiles, double-buffered L1 + L0A, loaded in parallel with MMAD).
// Accumulates C[M,N] = sum_t A_t[M,K] * B[K,N]. B stored TRANSPOSED [N,K] in GM so
// the L1->L0B load uses ifTranspose=false (works for every dtype on both archs).
// Measurement: first-MMAD-start -> last-MMAD-end span (from trace), not Total tick.
// argv: [1]=M [2]=K [3]=N [4]=dtype(half|float|int8|bf16)   (default 256 64 256 half)

constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t NUM_MMADS = 16;

// ---- dtype traits (device) ----
template <typename T>
struct CubeTraits;

template <>
struct CubeTraits<half> {
    using CT = float;
    using OutT = half;
    static constexpr QuantMode_t QM = QuantMode_t::F322F16;
};

template <>
struct CubeTraits<float> {
    using CT = float;
    using OutT = float;
    static constexpr QuantMode_t QM = QuantMode_t::NoQuant;
};

template <>
struct CubeTraits<int8_t> {
    using CT = int32_t;
    using OutT = int32_t;
    static constexpr QuantMode_t QM = QuantMode_t::NoQuant;
};

template <>
struct CubeTraits<bfloat16_t> {
    using CT = float;
    using OutT = bfloat16_t;
    static constexpr QuantMode_t QM = QuantMode_t::F322BF16;
};

// L1 -> L0A: load one A tile [M,K] (ifTranspose=false; K0 = 32/sizeof(T)).
template <typename T>
__aicore__ inline void LoadATile(const AscendC::LocalTensor<T>& a2, const AscendC::LocalTensor<T>& a1,
                                 uint32_t M, uint32_t K)
{
    constexpr uint32_t K0 = 32 / sizeof(T);
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
    AscendC::LoadData(a2, a1, AscendC::LoadData2DParamsV2{0, 0, static_cast<uint16_t>(M / 16),
                                                          static_cast<uint16_t>(K / K0),
                                                          static_cast<uint16_t>(M / 16),
                                                          static_cast<uint16_t>(M / 16), false, 0});
#else
    constexpr uint32_t E512 = 512 / sizeof(T);
    for (uint32_t i = 0; i < M / 16; ++i) {
        AscendC::LoadData(a2[i * K * 16], a1[i * E512],
                          AscendC::LoadData2DParams{0, static_cast<uint8_t>(K / K0),
                                                    static_cast<uint16_t>(M / 16), 0, 0, false, 0});
    }
#endif
}

// L1 -> L0B: load B [N,K] transposed (ifTranspose=false; K0 = 32/sizeof(T)).
template <typename T>
__aicore__ inline void LoadBTile(const AscendC::LocalTensor<T>& b2, const AscendC::LocalTensor<T>& b1,
                                 uint32_t N, uint32_t K)
{
    constexpr uint32_t K0 = 32 / sizeof(T);
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
    AscendC::LoadData(b2, b1, AscendC::LoadData2DParamsV2{0, 0, static_cast<uint16_t>(N / 16),
                                                          static_cast<uint16_t>(K / K0),
                                                          static_cast<uint16_t>(N / 16),
                                                          static_cast<uint16_t>(N / 16), false, 0});
#else
    for (uint32_t i = 0; i < K / K0; ++i) {
        AscendC::LoadData(b2[i * N * K0], b1[i * N * K0],
                          AscendC::LoadData2DParams{0, static_cast<uint8_t>(N / 16),
                                                    static_cast<uint16_t>(1), 0, 0, false, 0});
    }
#endif
}

template <typename T>
__global__ __cube__ void CubePeakKernel(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c,
                                        uint32_t M, uint32_t K, uint32_t N)
{
    AscendC::InitSocState();
    using CT = typename CubeTraits<T>::CT;
    using OutT = typename CubeTraits<T>::OutT;
    constexpr QuantMode_t QM = CubeTraits<T>::QM;

    AscendC::GlobalTensor<T> aGm;
    aGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(a), NUM_MMADS * M * K);
    AscendC::GlobalTensor<T> bGm;
    bGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b), N * K);  // transposed [N,K]
    AscendC::GlobalTensor<OutT> cGm;
    cGm.SetGlobalBuffer(reinterpret_cast<__gm__ OutT*>(c), M * N);

    AscendC::LocalMemAllocator<AscendC::Hardware::L0A> l0a;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0B> l0b;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0C> l0c;

    // L1 is addressed directly by byte offset. B is transient (loaded once into
    // L0B), so the 16 A-tiles reuse B's L1 space. 16*M*K*sizeof(T) <= 512KB is
    // guaranteed by the host guard M*K*sizeof(T) <= 32768.
    AscendC::LocalTensor<T> b1(AscendC::TPosition::B1, 0, N * K);  // transposed [N,K]
    AscendC::LocalTensor<T> a1[NUM_MMADS];
    for (uint32_t t = 0; t < NUM_MMADS; ++t) {
        a1[t] = AscendC::LocalTensor<T>(AscendC::TPosition::A1,
                                        static_cast<uint32_t>(t * M * K * sizeof(T)), M * K);
    }

    auto a2Ping = l0a.Alloc<AscendC::TPosition::A2, T>(M * K);
    auto a2Pong = l0a.Alloc<AscendC::TPosition::A2, T>(M * K);
    auto b2 = l0b.Alloc<AscendC::TPosition::B2, T>(N * K);  // transposed [N,K]
    auto cL0 = l0c.Alloc<AscendC::TPosition::CO1, CT>(M * N);

    AscendC::LocalTensor<T> a2[2];
    a2[0] = a2Ping;
    a2[1] = a2Pong;

    AscendC::Nd2NzParams bNz;  // B stored [N,K] transposed
    bNz.ndNum = 1;
    bNz.nValue = N;
    bNz.dValue = K;
    bNz.srcNdMatrixStride = 0;
    bNz.srcDValue = K;
    bNz.dstNzC0Stride = N;
    bNz.dstNzNStride = 1;
    bNz.dstNzMatrixStride = 0;

    AscendC::Nd2NzParams aNz;  // A [M,K]
    aNz.ndNum = 1;
    aNz.nValue = M;
    aNz.dValue = K;
    aNz.srcNdMatrixStride = 0;
    aNz.srcDValue = K;
    aNz.dstNzC0Stride = M;
    aNz.dstNzNStride = 1;
    aNz.dstNzMatrixStride = 0;

    // ---- Load B (static, transposed [N,K]) into L0B ----
    AscendC::DataCopy(b1, bGm, bNz);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID3);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID3);
    LoadBTile<T>(b2, b1, N, K);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID3);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID3);

    // ---- Preload all 16 A-tiles into L1 (one MTE2 burst, then MTE1-only loop) ----
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
    for (uint32_t t = 0; t < NUM_MMADS; ++t) {
        AscendC::DataCopy(a1[t], aGm[t * M * K], aNz);
    }
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID2);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID2);

    // ---- pre-set L0A-free flags (avoid first-iteration deadlock) ----
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID1);

    // ---- prologue: load A[0] into L0A[0] ----
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0);
    LoadATile<T>(a2[0], a1[0], M, K);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

    // ---- main loop: 16 MMADs, double-buffered MTE1 (L1 -> L0A) only ----
    uint8_t db = 0;
    for (uint32_t t = 0; t < NUM_MMADS; ++t) {
        if (t + 1 < NUM_MMADS) {
            uint8_t nxt = db ^ 1;
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0 + nxt);
            LoadATile<T>(a2[nxt], a1[t + 1], M, K);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0 + nxt);
        }
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0 + db);
        AscendC::Mmad(cL0, a2[db], b2,
                      AscendC::MmadParams{static_cast<uint16_t>(M), static_cast<uint16_t>(N),
                                          static_cast<uint16_t>(K), 0, false, t == 0});
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID0 + db);
        db ^= 1;
    }

    // ---- CopyOut: Fixpipe L0C -> GM ----
    AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
    AscendC::FixpipeParamsV220 fp;
    fp.nSize = N;
    fp.mSize = M;
    fp.srcStride = M;
    fp.dstStride = N;
    fp.reluEn = false;
    fp.quantPre = QM;
    fp.ndNum = 1;
    fp.srcNdStride = 0;
    fp.dstNdStride = 0;
    fp.unitFlag = 0;
    AscendC::Fixpipe(cGm, cL0, fp);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ---- host element IO (store double -> dtype bytes, load dtype bytes -> double) ----
template <typename T>
struct ElemIO;

template <>
struct ElemIO<half> {
    static inline void store(uint8_t* d, double v)
    {
        uint16_t h = lab::F16(static_cast<float>(v));
        std::memcpy(d, &h, 2);
    }
    static inline double load(const uint8_t* s)
    {
        uint16_t h;
        std::memcpy(&h, s, 2);
        return lab::F32(h);
    }
};

template <>
struct ElemIO<bfloat16_t> {
    static inline void store(uint8_t* d, double v)
    {
        uint16_t h = lab::BF16(static_cast<float>(v));
        std::memcpy(d, &h, 2);
    }
    static inline double load(const uint8_t* s)
    {
        uint16_t h;
        std::memcpy(&h, s, 2);
        return lab::BF32(h);
    }
};

template <>
struct ElemIO<float> {
    static inline void store(uint8_t* d, double v)
    {
        float f = static_cast<float>(v);
        std::memcpy(d, &f, 4);
    }
    static inline double load(const uint8_t* s)
    {
        float f;
        std::memcpy(&f, s, 4);
        return static_cast<double>(f);
    }
};

template <>
struct ElemIO<int8_t> {
    static inline void store(uint8_t* d, double v)
    {
        int8_t x = static_cast<int8_t>(v + (v >= 0.0 ? 0.5 : -0.5));
        std::memcpy(d, &x, 1);
    }
    static inline double load(const uint8_t* s)
    {
        int8_t x;
        std::memcpy(&x, s, 1);
        return static_cast<double>(x);
    }
};

template <>
struct ElemIO<int32_t> {
    static inline void store(uint8_t* d, double v)
    {
        int32_t x = static_cast<int32_t>(v + (v >= 0.0 ? 0.5 : -0.5));
        std::memcpy(d, &x, 4);
    }
    static inline double load(const uint8_t* s)
    {
        int32_t x;
        std::memcpy(&x, s, 4);
        return static_cast<double>(x);
    }
};

template <typename T>
int Run(uint32_t M, uint32_t K, uint32_t N)
{
    using CT = typename CubeTraits<T>::CT;
    using OutT = typename CubeTraits<T>::OutT;
    constexpr size_t ts = sizeof(T);
    constexpr size_t cs = sizeof(CT);    // L0C accumulator size (float/int32 = 4B)
    constexpr size_t os = sizeof(OutT);  // Fixpipe output size
    constexpr double kScale = (sizeof(T) == 1) ? 120.0 : 1.0;  // int8 -> wider range

    // Buffer-capacity guard. Exceeding these limits silently corrupts C (the
    // on-core allocators do not bounds-check), so reject oversized inputs up front.
    constexpr size_t L0A_CAP = 64 * 1024;   // L0A total capacity (both archs)
    constexpr size_t L0B_CAP = 64 * 1024;   // L0B total capacity (both archs)
#if defined(ASCENDC_L0C_CAP_BYTES)
    constexpr size_t L0C_CAP = ASCENDC_L0C_CAP_BYTES;  // set by CMake (dav-2201=131072, dav-3510=262144)
#else
    constexpr size_t L0C_CAP = 128 * 1024;
#endif
#if defined(ASCENDC_L1_CAP_BYTES)
    constexpr size_t L1_CAP = ASCENDC_L1_CAP_BYTES;  // set by CMake (dav-2201=523776, dav-3510=524288)
#else
    constexpr size_t L1_CAP = 512 * 1024;
#endif
    // A is double-buffered in L0A: each of the 2 buffers holds one M*K tile.
    if (M * K * ts > L0A_CAP / 2) {
        std::cerr << "cube_peak: M*K*sizeof(T)=" << (M * K * ts)
                  << " exceeds half L0A (" << (L0A_CAP / 2) << " bytes); result would silently corrupt\n";
        return 1;
    }
    if (K * N * ts > L0B_CAP) {
        std::cerr << "cube_peak: K*N*sizeof(T)=" << (K * N * ts)
                  << " exceeds L0B (" << L0B_CAP << " bytes); result would silently corrupt\n";
        return 1;
    }
    if (M * N * cs > L0C_CAP) {
        std::cerr << "cube_peak: M*N*sizeof(CT)=" << (M * N * cs)
                  << " exceeds L0C (" << L0C_CAP << " bytes); result would silently corrupt\n";
        return 1;
    }
    // All NUM_MMADS A-tiles are preloaded into L1 (B is transient and reuses that
    // space), so the whole A stream must fit. dav-2201 reserves 256B of L1.
    if (NUM_MMADS * M * K * ts > L1_CAP) {
        std::cerr << "cube_peak: " << NUM_MMADS << "*M*K*sizeof(T)=" << (NUM_MMADS * M * K * ts)
                  << " exceeds L1 (" << L1_CAP << " bytes); result would silently corrupt\n";
        return 1;
    }

    try {
        std::vector<uint8_t> aHost(NUM_MMADS * M * K * ts);
        std::vector<uint8_t> bHost(N * K * ts);  // transposed [N,K]
        std::vector<double> aSum(M * K, 0.0);

        for (uint32_t n = 0; n < N; ++n) {
            for (uint32_t k = 0; k < K; ++k) {
                double v = kScale * (static_cast<double>((k * N + n) % 23) - 11.0) / 23.0;
                ElemIO<T>::store(&bHost[(n * K + k) * ts], v);
            }
        }
        for (uint32_t t = 0; t < NUM_MMADS; ++t) {
            for (uint32_t m = 0; m < M; ++m) {
                for (uint32_t k = 0; k < K; ++k) {
                    double v = kScale * (static_cast<double>((t * M * K + m * K + k) % 31) - 15.0) / 31.0;
                    uint8_t* dst = &aHost[(t * M * K + m * K + k) * ts];
                    ElemIO<T>::store(dst, v);
                    aSum[m * K + k] += ElemIO<T>::load(dst);
                }
            }
        }

        // cRef[m,n] = sum_k aSum[m,k] * B_true[k,n], B_true[k,n] = bHost[n,k]
        std::vector<double> cRef(M * N, 0.0);
        double scale = 0.0;
        for (uint32_t m = 0; m < M; ++m) {
            for (uint32_t n = 0; n < N; ++n) {
                double acc = 0.0;
                for (uint32_t k = 0; k < K; ++k) {
                    acc += aSum[m * K + k] * ElemIO<T>::load(&bHost[(n * K + k) * ts]);
                }
                cRef[m * N + n] = acc;
                if (std::fabs(acc) > scale) scale = std::fabs(acc);
            }
        }

        double tol;
        if (sizeof(T) == 1) {
            tol = 0.5;  // int8 -> exact int32 accumulation (allow rounding slack only)
        } else if (sizeof(T) == 4) {
            tol = 1e-3 * (1.0 + scale);  // float
        } else {
            tol = 0.02 * (1.0 + scale);  // half / bfloat16
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream");

        uint8_t* aDev = nullptr;
        uint8_t* bDev = nullptr;
        uint8_t* cDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&aDev), NUM_MMADS * M * K * ts, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&bDev), N * K * ts, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&cDev), M * N * os, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(aDev, NUM_MMADS * M * K * ts, aHost.data(), NUM_MMADS * M * K * ts, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(bDev, N * K * ts, bHost.data(), N * K * ts, ACL_MEMCPY_HOST_TO_DEVICE);

        CubePeakKernel<T><<<1, 0, stream>>>(aDev, bDev, cDev, M, K, N);
        aclrtSynchronizeStream(stream);

        std::vector<uint8_t> cHost(M * N * os);
        aclrtMemcpy(cHost.data(), M * N * os, cDev, M * N * os, ACL_MEMCPY_DEVICE_TO_HOST);

        double maxErr = 0.0;
        for (uint32_t i = 0; i < M * N; ++i) {
            double err = std::fabs(ElemIO<OutT>::load(&cHost[i * os]) - cRef[i]);
            if (err > maxErr) maxErr = err;
        }
        bool ok = maxErr < tol;

        aclrtFree(aDev);
        aclrtFree(bDev);
        aclrtFree(cDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "cube_peak M=" << M << " K=" << K << " N=" << N << " : " << (ok ? "PASS" : "FAIL")
                  << " (maxErr=" << maxErr << " tol=" << tol << ")\n";
        return ok ? 0 : 1;
    } catch (const std::exception& e) {
        std::cerr << "cube_peak: " << e.what() << '\n';
        return 1;
    }
}

int main(int argc, char* argv[])
{
    uint32_t M = 256, K = 64, N = 256;
    std::string dtype = "half";
    if (argc > 1) M = static_cast<uint32_t>(std::strtoul(argv[1], nullptr, 10));
    if (argc > 2) K = static_cast<uint32_t>(std::strtoul(argv[2], nullptr, 10));
    if (argc > 3) N = static_cast<uint32_t>(std::strtoul(argv[3], nullptr, 10));
    if (argc > 4) dtype = argv[4];

    if (dtype == "half") return Run<half>(M, K, N);
    if (dtype == "float") return Run<float>(M, K, N);
    if (dtype == "int8") return Run<int8_t>(M, K, N);
    if (dtype == "bf16") return Run<bfloat16_t>(M, K, N);
    std::cerr << "cube_peak: unknown dtype '" << dtype << "' (half|float|int8|bf16)\n";
    return 2;
}
