#include <cmath>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "half_utils.h"

constexpr uint32_t kLength = 4096;

// RegBase (dav-3510 only) half-precision vector body. Same operation sequence as
// arith_simd.asc but with half (binary16), so one vector register covers
// GetVecLen()/sizeof(half) = 128 elements instead of 64.
template <uint32_t Length>
__simd_vf__ inline void ArithHalfVF(__ubuf__ half* a, __ubuf__ half* b, __ubuf__ half* out)
{
    constexpr uint32_t elementsPerVector = AscendC::GetVecLen() / sizeof(half);
    constexpr uint32_t repeats = (Length + elementsPerVector - 1) / elementsPerVector;
    uint32_t remaining = Length;
    AscendC::Reg::RegTensor<half> ar;
    AscendC::Reg::RegTensor<half> br;
    AscendC::Reg::RegTensor<half> tr;
    AscendC::Reg::MaskReg mask;

    for (uint32_t i = 0; i < repeats; ++i) {
        mask = AscendC::Reg::UpdateMask<half>(remaining);
        AscendC::Reg::LoadAlign(ar, a + i * elementsPerVector);
        AscendC::Reg::LoadAlign(br, b + i * elementsPerVector);

        AscendC::Reg::Add(ar, ar, br, mask);                         // a += b
        AscendC::Reg::LoadAlign(ar, b + i * elementsPerVector);      // a = b
        AscendC::Reg::Div(ar, ar, br, mask);                         // a /= b
        AscendC::Reg::Add(br, br, ar, mask);                         // b += a
        AscendC::Reg::Mul(br, br, ar, mask);                         // b *= a
        AscendC::Reg::Div(br, br, ar, mask);                         // b /= a
        AscendC::Reg::Add(tr, ar, br, mask);                         // out = a + b
        AscendC::Reg::StoreAlign(out + i * elementsPerVector, tr, mask);
    }
}

__global__ __vector__ void ArithSimdHalfKernel(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* out)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<half> aGm;
    AscendC::GlobalTensor<half> bGm;
    AscendC::GlobalTensor<half> outGm;
    aGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a), kLength);
    bGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b), kLength);
    outGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(out), kLength);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    auto aLocal = allocator.Alloc<half, kLength>();
    auto bLocal = allocator.Alloc<half, kLength>();
    auto outLocal = allocator.Alloc<half, kLength>();

    AscendC::DataCopy(aLocal, aGm, kLength);
    AscendC::DataCopy(bLocal, bGm, kLength);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    asc_vf_call<ArithHalfVF<kLength>>(
        reinterpret_cast<__ubuf__ half*>(aLocal.GetPhyAddr()),
        reinterpret_cast<__ubuf__ half*>(bLocal.GetPhyAddr()),
        reinterpret_cast<__ubuf__ half*>(outLocal.GetPhyAddr()));

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(outGm, outLocal, kLength);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main()
{
    try {
        constexpr size_t bytes = kLength * sizeof(uint16_t);
        std::vector<uint16_t> a(kLength);
        std::vector<uint16_t> b(kLength);
        std::vector<uint16_t> out(kLength);
        std::vector<float> expected(kLength);
        for (uint32_t i = 0; i < kLength; ++i) {
            a[i] = lab::F16(1.0f + static_cast<float>(i % 10) * 0.1f);
            b[i] = lab::F16(1.0f + static_cast<float>(i % 7) * 0.5f);
            expected[i] = lab::F32(b[i]) + 2.0f;
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        uint16_t* aDev = nullptr;
        uint16_t* bDev = nullptr;
        uint16_t* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&aDev), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&bDev), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(aDev, bytes, a.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(bDev, bytes, b.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);

        ArithSimdHalfKernel<<<1, 0, stream>>>(
            reinterpret_cast<uint8_t*>(aDev),
            reinterpret_cast<uint8_t*>(bDev),
            reinterpret_cast<uint8_t*>(outDev));
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), bytes, outDev, bytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kLength; ++i) {
            if (std::fabs(lab::F32(out[i]) - expected[i]) > 5.0e-2f) {
                std::cerr << "arith_simd_half mismatch at " << i << ": expected " << expected[i] << ", got "
                          << lab::F32(out[i]) << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(aDev);
        aclrtFree(bDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "arith_simd_half: " << (ok ? "PASS" : "FAIL") << " (" << kLength << " elements)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "arith_simd_half: " << error.what() << '\n';
        return 1;
    }
}
