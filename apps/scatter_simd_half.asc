#include <cmath>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "half_utils.h"

constexpr uint32_t kN = 4096;

// Low-level SIMD half scatter: dst[index[i]] = src[i] via the vscatter basic API.
// index holds BYTE offsets, so for half (2 bytes) it is (kN-1-i)*2.
__global__ __vector__ void ScatterSimdHalfKernel(__gm__ uint8_t* src, __gm__ uint32_t* index, __gm__ uint8_t* dst)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<half> srcGm;
    AscendC::GlobalTensor<uint32_t> idxGm;
    AscendC::GlobalTensor<half> dstGm;
    srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(src), kN);
    idxGm.SetGlobalBuffer(index, kN);
    dstGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(dst), kN);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    auto srcLocal = allocator.Alloc<half, kN>();
    auto idxLocal = allocator.Alloc<uint32_t, kN>();
    auto dstLocal = allocator.Alloc<half, kN>();

    AscendC::DataCopy(srcLocal, srcGm, kN);
    AscendC::DataCopy(idxLocal, idxGm, kN);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::Scatter(dstLocal, srcLocal, idxLocal, 0, kN);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGm, dstLocal, kN);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main()
{
    try {
        constexpr size_t dataBytes = kN * sizeof(uint16_t);
        constexpr size_t idxBytes = kN * sizeof(uint32_t);
        std::vector<uint16_t> src(kN);
        std::vector<uint32_t> index(kN);
        std::vector<uint16_t> dst(kN);
        std::vector<float> expected(kN, 0.0f);
        for (uint32_t i = 0; i < kN; ++i) {
            src[i] = lab::F16(0.5f + static_cast<float>(i % 97) * 0.25f);
            index[i] = (kN - 1 - i) * 2; // Scatter offset is a BYTE address (2 bytes per half)
        }
        for (uint32_t i = 0; i < kN; ++i) {
            expected[kN - 1 - i] = lab::F32(src[i]);
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        uint16_t* srcDev = nullptr;
        uint32_t* idxDev = nullptr;
        uint16_t* dstDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&srcDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&idxDev), idxBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&dstDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(srcDev, dataBytes, src.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(idxDev, idxBytes, index.data(), idxBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemset(dstDev, dataBytes, 0, dataBytes);

        ScatterSimdHalfKernel<<<1, 0, stream>>>(
            reinterpret_cast<uint8_t*>(srcDev), idxDev, reinterpret_cast<uint8_t*>(dstDev));
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(dst.data(), dataBytes, dstDev, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kN; ++i) {
            if (std::fabs(lab::F32(dst[i]) - expected[i]) > 1.0e-3f) {
                std::cerr << "scatter_simd_half mismatch at " << i << ": expected " << expected[i] << ", got "
                          << lab::F32(dst[i]) << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(srcDev);
        aclrtFree(idxDev);
        aclrtFree(dstDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "scatter_simd_half: " << (ok ? "PASS" : "FAIL") << " (" << kN << " elements)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "scatter_simd_half: " << error.what() << '\n';
        return 1;
    }
}
