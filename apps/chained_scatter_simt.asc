#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <random>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

// Chained-scatter benchmark (SIMT): the transpose of chained_gather.
//
// Unlike the gather (report 06), which READS a neighbour thread's shared-memory
// slot at every level, the scatter formulation makes each thread SELF-CONTAINED:
//   smem[l+1][perm[l](idx)] = smem[l][idx]   with idx tracked per-thread
// Because every perm[l] is a bijection, the slot a thread reads at level l is
// exactly the slot it wrote at level l-1, so there is NO cross-thread read and
// therefore NO need for an asc_syncthreads() barrier. (Scatter with repeating
// indices is ill-defined: two threads would write the same slot.)
//
// argv[1]: "perm" (permutation of 0..kChunk-1; repeats are not supported).
// argv[2] (optional): repeat count (default 8).
// argv[3] (optional): "nosync" to drop the barriers (expected to still PASS).

constexpr uint32_t kChunk = 128;
constexpr uint32_t kNumChunks = 8;
constexpr uint32_t kTotal = kChunk * kNumChunks;
constexpr uint32_t kLevels = 4;
constexpr uint32_t kThreads = kChunk;

// kSync=false removes the full-block barriers between scatter levels. Because
// each thread only ever reads its own previous write, this is expected to be
// correct (unlike the gather, where nosync is a data race).
template <bool kSync>
__global__ __launch_bounds__(kThreads) void ChainedScatterSimtKernel(
    float* src, uint32_t* perm, float* out, uint32_t repeats)
{
    extern __ubuf__ float smem[]; // [0,128)=a1 [128,256)=a2 [256,384)=a3
    uint32_t pos = threadIdx.x;

    for (uint32_t r = 0; r < repeats; ++r) {
        for (uint32_t chunk = 0; chunk < kNumChunks; ++chunk) {
            uint32_t idx = pos;
            uint32_t nidx = perm[0 * kChunk + idx];
            smem[0 * kChunk + nidx] = src[chunk * kChunk + idx];
            if (kSync) asc_syncthreads();
            idx = nidx;
            nidx = perm[1 * kChunk + idx];
            smem[1 * kChunk + nidx] = smem[0 * kChunk + idx];
            if (kSync) asc_syncthreads();
            idx = nidx;
            nidx = perm[2 * kChunk + idx];
            smem[2 * kChunk + nidx] = smem[1 * kChunk + idx];
            if (kSync) asc_syncthreads();
            idx = nidx;
            nidx = perm[3 * kChunk + idx];
            out[chunk * kChunk + nidx] = smem[2 * kChunk + idx];
        }
    }
}

int main(int argc, char* argv[])
{
    std::string variant = (argc > 1) ? argv[1] : "perm";
    if (variant != "perm") {
        std::cerr << "chained_scatter_simt: variant must be 'perm' (repeats are ill-defined for scatter)\n";
        return 2;
    }
    uint32_t repeats = 8;
    if (argc > 2) {
        repeats = static_cast<uint32_t>(std::strtoul(argv[2], nullptr, 10));
        if (repeats == 0) repeats = 1;
    }
    bool sync = true;
    if (argc > 3 && std::string(argv[3]) == "nosync") sync = false;

    try {
        constexpr size_t dataBytes = kTotal * sizeof(float);
        constexpr size_t permBytes = kLevels * kChunk * sizeof(uint32_t);
        std::vector<float> src(kTotal);
        std::vector<uint32_t> perm(kLevels * kChunk); // perm[l*kChunk+i] = image of i under level l
        std::vector<float> out(kTotal);
        std::vector<float> expected(kTotal);

        for (uint32_t i = 0; i < kTotal; ++i) {
            src[i] = 0.5f + static_cast<float>(i % 97) * 0.25f;
        }
        std::mt19937 gen(42);
        for (uint32_t l = 0; l < kLevels; ++l) {
            for (uint32_t i = 0; i < kChunk; ++i) {
                perm[l * kChunk + i] = i;
            }
            std::shuffle(perm.begin() + l * kChunk, perm.begin() + (l + 1) * kChunk, gen);
        }

        for (uint32_t c = 0; c < kNumChunks; ++c) {
            for (uint32_t i = 0; i < kChunk; ++i) {
                uint32_t e = i;
                for (uint32_t l = 0; l < kLevels; ++l) {
                    e = perm[l * kChunk + e];
                }
                expected[c * kChunk + e] = src[c * kChunk + i];
            }
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        float* srcDev = nullptr;
        uint32_t* permDev = nullptr;
        float* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&srcDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&permDev), permBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(srcDev, dataBytes, src.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(permDev, permBytes, perm.data(), permBytes, ACL_MEMCPY_HOST_TO_DEVICE);

        // Shared memory: 3 levels x 128 floats. dyn_ubuf_size is in 32-byte units.
        constexpr uint32_t dynUbSize = (kLevels - 1) * kChunk * sizeof(float) / 32;
        if (sync) {
            ChainedScatterSimtKernel<true><<<1, kThreads, dynUbSize, stream>>>(srcDev, permDev, outDev, repeats);
        } else {
            ChainedScatterSimtKernel<false><<<1, kThreads, dynUbSize, stream>>>(srcDev, permDev, outDev, repeats);
        }
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), dataBytes, outDev, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kTotal; ++i) {
            if (out[i] != expected[i]) {
                std::cerr << "chained_scatter_simt[" << variant << "] mismatch at " << i << ": expected "
                          << expected[i] << ", got " << out[i] << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(srcDev);
        aclrtFree(permDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "chained_scatter_simt[" << variant << (sync ? "" : ",nosync") << "]: " << (ok ? "PASS" : "FAIL")
                  << " (" << kTotal << " elems x " << kLevels << " levels)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "chained_scatter_simt: " << error.what() << '\n';
        return 1;
    }
}
