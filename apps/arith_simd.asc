#include <cmath>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t kLength = 4096;

// RegBase (dav-3510 only) vector-body for the requested operation sequence:
//   a += b; a = b; a /= b; b += a; b *= a; b /= a; out = a + b
// With b != 0 this reduces to out[i] = b[i] + 2, used for verification.
template <uint32_t Length>
__simd_vf__ inline void ArithVF(__ubuf__ float* a, __ubuf__ float* b, __ubuf__ float* out)
{
    constexpr uint32_t elementsPerVector = AscendC::GetVecLen() / sizeof(float);
    constexpr uint32_t repeats = (Length + elementsPerVector - 1) / elementsPerVector;
    uint32_t remaining = Length;
    AscendC::Reg::RegTensor<float> ar;
    AscendC::Reg::RegTensor<float> br;
    AscendC::Reg::RegTensor<float> tr;
    AscendC::Reg::MaskReg mask;

    for (uint32_t i = 0; i < repeats; ++i) {
        mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::LoadAlign(ar, a + i * elementsPerVector);
        AscendC::Reg::LoadAlign(br, b + i * elementsPerVector);

        AscendC::Reg::Add(ar, ar, br, mask);                         // a += b
        AscendC::Reg::LoadAlign(ar, b + i * elementsPerVector);      // a = b
        AscendC::Reg::Div(ar, ar, br, mask);                         // a /= b
        AscendC::Reg::Add(br, br, ar, mask);                         // b += a
        AscendC::Reg::Mul(br, br, ar, mask);                         // b *= a
        AscendC::Reg::Div(br, br, ar, mask);                         // b /= a
        AscendC::Reg::Add(tr, ar, br, mask);                         // out = a + b
        AscendC::Reg::StoreAlign(out + i * elementsPerVector, tr, mask);
    }
}

__global__ __vector__ void ArithSimdKernel(__gm__ float* a, __gm__ float* b, __gm__ float* out)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> aGm;
    AscendC::GlobalTensor<float> bGm;
    AscendC::GlobalTensor<float> outGm;
    aGm.SetGlobalBuffer(a, kLength);
    bGm.SetGlobalBuffer(b, kLength);
    outGm.SetGlobalBuffer(out, kLength);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    auto aLocal = allocator.Alloc<float, kLength>();
    auto bLocal = allocator.Alloc<float, kLength>();
    auto outLocal = allocator.Alloc<float, kLength>();

    AscendC::DataCopy(aLocal, aGm, kLength);
    AscendC::DataCopy(bLocal, bGm, kLength);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    asc_vf_call<ArithVF<kLength>>(
        reinterpret_cast<__ubuf__ float*>(aLocal.GetPhyAddr()),
        reinterpret_cast<__ubuf__ float*>(bLocal.GetPhyAddr()),
        reinterpret_cast<__ubuf__ float*>(outLocal.GetPhyAddr()));

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(outGm, outLocal, kLength);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main()
{
    try {
        constexpr size_t bytes = kLength * sizeof(float);
        std::vector<float> a(kLength);
        std::vector<float> b(kLength);
        std::vector<float> out(kLength);
        std::vector<float> expected(kLength);
        for (uint32_t i = 0; i < kLength; ++i) {
            a[i] = 1.0f + static_cast<float>(i % 10) * 0.1f;
            b[i] = 1.0f + static_cast<float>(i % 7) * 0.5f;
            expected[i] = b[i] + 2.0f;
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        float* aDev = nullptr;
        float* bDev = nullptr;
        float* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&aDev), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&bDev), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(aDev, bytes, a.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(bDev, bytes, b.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);

        ArithSimdKernel<<<1, 0, stream>>>(aDev, bDev, outDev);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), bytes, outDev, bytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kLength; ++i) {
            if (std::fabs(out[i] - expected[i]) > 1.0e-2f) {
                std::cerr << "arith_simd mismatch at " << i << ": expected " << expected[i] << ", got " << out[i]
                          << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(aDev);
        aclrtFree(bDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "arith_simd: " << (ok ? "PASS" : "FAIL") << " (" << kLength << " elements)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "arith_simd: " << error.what() << '\n';
        return 1;
    }
}
