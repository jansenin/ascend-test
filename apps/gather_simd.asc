#include <cmath>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t kN = 4096;

// Low-level SIMD gather: out[i] = src[index[i]] via the vgather basic API
// (direct hardware instruction, no high-level operator framework).
__global__ __vector__ void GatherSimdKernel(__gm__ float* src, __gm__ uint32_t* index, __gm__ float* out)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<uint32_t> idxGm;
    AscendC::GlobalTensor<float> outGm;
    srcGm.SetGlobalBuffer(src, kN);
    idxGm.SetGlobalBuffer(index, kN);
    outGm.SetGlobalBuffer(out, kN);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    auto srcLocal = allocator.Alloc<float, kN>();
    auto idxLocal = allocator.Alloc<uint32_t, kN>();
    auto outLocal = allocator.Alloc<float, kN>();

    AscendC::DataCopy(srcLocal, srcGm, kN);
    AscendC::DataCopy(idxLocal, idxGm, kN);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::Gather(outLocal, srcLocal, idxLocal, 0, kN);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(outGm, outLocal, kN);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main()
{
    try {
        constexpr size_t dataBytes = kN * sizeof(float);
        constexpr size_t idxBytes = kN * sizeof(uint32_t);
        std::vector<float> src(kN);
        std::vector<uint32_t> index(kN);
        std::vector<float> out(kN);
        std::vector<float> expected(kN);
        for (uint32_t i = 0; i < kN; ++i) {
            src[i] = 0.5f + static_cast<float>(i % 97) * 0.25f;
            index[i] = (kN - 1 - i) * sizeof(float); // Gather offset is a BYTE address
        }
        for (uint32_t i = 0; i < kN; ++i) {
            expected[i] = src[kN - 1 - i];
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        float* srcDev = nullptr;
        uint32_t* idxDev = nullptr;
        float* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&srcDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&idxDev), idxBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(srcDev, dataBytes, src.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(idxDev, idxBytes, index.data(), idxBytes, ACL_MEMCPY_HOST_TO_DEVICE);

        GatherSimdKernel<<<1, 0, stream>>>(srcDev, idxDev, outDev);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), dataBytes, outDev, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kN; ++i) {
            if (out[i] != expected[i]) {
                std::cerr << "gather_simd mismatch at " << i << ": expected " << expected[i] << ", got " << out[i]
                          << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(srcDev);
        aclrtFree(idxDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "gather_simd: " << (ok ? "PASS" : "FAIL") << " (" << kN << " elements)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "gather_simd: " << error.what() << '\n';
        return 1;
    }
}
