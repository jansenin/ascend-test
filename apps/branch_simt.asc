#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

// Divergent-branch benchmark (SIMT).
//
//   y = (x < threshold) ? expensive(x) : x
//
// where expensive(x) is kExpensiveK iterations of e = e*0.5 + 0.5. The "rare"
// condition is true for ~1% of elements. SIMT uses a native per-thread branch:
// a warp with no rare element skips the expensive path entirely, and only
// warps that actually diverge pay the expensive cost.

constexpr uint32_t kLength = 4096;
constexpr uint32_t kThreads = 256;
constexpr float kThreshold = 0.01f;
constexpr uint32_t kExpensiveK = 64;

__global__ void BranchSimtKernel(float* in, float* out, uint32_t length)
{
    for (uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x; idx < length;
         idx += blockDim.x * gridDim.x) {
        float v = in[idx];
        if (v < kThreshold) {
            float e = v;
            for (uint32_t k = 0; k < kExpensiveK; ++k) {
                e = e * 0.5f + 0.5f;
            }
            out[idx] = e;
        } else {
            out[idx] = v;
        }
    }
}

int main(int argc, char* argv[])
{
    (void)argc;
    (void)argv;

    try {
        constexpr size_t dataBytes = kLength * sizeof(float);
        std::vector<float> in(kLength);
        std::vector<float> out(kLength);
        std::vector<float> expected(kLength);

        for (uint32_t i = 0; i < kLength; ++i) {
            in[i] = (i % 100 == 0) ? 0.001f : (0.5f + static_cast<float>(i % 97) * 0.25f);
            float e = in[i];
            for (uint32_t k = 0; k < kExpensiveK; ++k) {
                e = e * 0.5f + 0.5f;
            }
            expected[i] = (in[i] < kThreshold) ? e : in[i];
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        float* inDev = nullptr;
        float* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&inDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(inDev, dataBytes, in.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE);

        BranchSimtKernel<<<1, kThreads, 0, stream>>>(inDev, outDev, kLength);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), dataBytes, outDev, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kLength; ++i) {
            if (out[i] != expected[i]) {
                std::cerr << "branch_simt mismatch at " << i << ": expected " << expected[i] << ", got "
                          << out[i] << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(inDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "branch_simt: " << (ok ? "PASS" : "FAIL") << " (" << kLength << " elems)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "branch_simt: " << error.what() << '\n';
        return 1;
    }
}
