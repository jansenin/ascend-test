#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

// Memory-bank microbenchmark: 16 vector adds of the SAME two inputs, measured by
// the ADD-issue interval from the simulator instruction log (like the cube MMAD
// sweep). The only thing that varies is the UB placement of the operand/output
// blocks:
//   dense  -> blocks packed back-to-back (1024 floats = 4096 B each)
//   sparse -> 128 B of empty space between blocks (half a 256 B bank group)
// A 256-byte "bank group" = 8 banks x 32 B, so an address and address+256 B land
// on the same bank. Dense: lhs/rhs/dst are all bank-aligned -> same-bank access.
// Sparse: the 128 B shift puts adjacent operands 4 banks apart -> no conflict.

constexpr uint32_t kBlock = 1024;    // float elements per block
constexpr uint32_t kNumAdds = 16;    // number of independent adds
constexpr uint32_t kGap = 32;        // 128 bytes of gap, in float elements

__global__ __vector__ void BankAddKernel(__gm__ float* lhsGm, __gm__ float* rhsGm, __gm__ float* outGm, uint32_t gap)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> lhsG;
    AscendC::GlobalTensor<float> rhsG;
    AscendC::GlobalTensor<float> outG;
    lhsG.SetGlobalBuffer(lhsGm, kBlock);
    rhsG.SetGlobalBuffer(rhsGm, kBlock);
    outG.SetGlobalBuffer(outGm, kNumAdds * kBlock);

    const uint32_t stride = kBlock + gap;  // elements per block incl. gap

    AscendC::LocalTensor<float> lhs(AscendC::TPosition::VECIN, 0, kBlock);
    AscendC::LocalTensor<float> rhs(AscendC::TPosition::VECIN, stride * sizeof(float), kBlock);
    AscendC::LocalTensor<float> dst[kNumAdds];
    for (uint32_t i = 0; i < kNumAdds; ++i) {
        dst[i] = AscendC::LocalTensor<float>(AscendC::TPosition::VECOUT,
                                             (2 + i) * stride * sizeof(float), kBlock);
    }

    AscendC::DataCopy(lhs, lhsG, kBlock);
    AscendC::DataCopy(rhs, rhsG, kBlock);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    for (uint32_t i = 0; i < kNumAdds; ++i) {
        AscendC::Add(dst[i], lhs, rhs, kBlock);
    }

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    for (uint32_t i = 0; i < kNumAdds; ++i) {
        AscendC::DataCopy(outG[i * kBlock], dst[i], kBlock);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main(int argc, char* argv[])
{
    std::string mode = (argc > 1) ? argv[1] : "dense";
    uint32_t gap;
    if (mode == "dense") {
        gap = 0;
    } else if (mode == "sparse") {
        gap = kGap;
    } else {
        std::cerr << "bank_add: usage: " << argv[0] << " [dense|sparse]\n";
        return 2;
    }

    try {
        constexpr size_t inBytes = kBlock * sizeof(float);
        constexpr size_t outBytes = kNumAdds * kBlock * sizeof(float);

        std::vector<float> lhs(kBlock);
        std::vector<float> rhs(kBlock);
        std::vector<float> out(kNumAdds * kBlock);
        std::vector<float> expected(kBlock);
        for (uint32_t i = 0; i < kBlock; ++i) {
            lhs[i] = 1.0f + static_cast<float>(i % 7) * 0.25f;
            rhs[i] = 1.0f + static_cast<float>(i % 5) * 0.5f;
            expected[i] = lhs[i] + rhs[i];
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        float* lhsDev = nullptr;
        float* rhsDev = nullptr;
        float* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&lhsDev), inBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&rhsDev), inBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), outBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(lhsDev, inBytes, lhs.data(), inBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(rhsDev, inBytes, rhs.data(), inBytes, ACL_MEMCPY_HOST_TO_DEVICE);

        BankAddKernel<<<1, 0, stream>>>(lhsDev, rhsDev, outDev, gap);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), outBytes, outDev, outBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t a = 0; a < kNumAdds && ok; ++a) {
            for (uint32_t i = 0; i < kBlock; ++i) {
                if (std::fabs(out[a * kBlock + i] - expected[i]) > 1.0e-4f) {
                    std::cerr << "bank_add " << mode << " mismatch: add " << a << " elem " << i << " expected "
                              << expected[i] << " got " << out[a * kBlock + i] << '\n';
                    ok = false;
                    break;
                }
            }
        }

        aclrtFree(lhsDev);
        aclrtFree(rhsDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "bank_add " << mode << ": " << (ok ? "PASS" : "FAIL") << " (16 x " << kBlock
                  << " float adds, gap=" << gap << " elems)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "bank_add: " << error.what() << '\n';
        return 1;
    }
}
