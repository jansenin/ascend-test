#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

// Memory-bank placement microbenchmark: 16 vector adds of the SAME two inputs,
// measured by the ADD-issue interval from the simulator instruction log (like the
// cube MMAD sweep). Three operands (lhs read, rhs read, dst write) are placed at
// independently controllable UB byte offsets so we can move each into a different
// bank group:
//   lhs @ 0
//   rhs @ kBlock*4 + rhsGapBytes
//   dst[i] @ 4*kBlock*4 + dstGapBytes + i*kBlock*4
// where kBlock*4 = 4096 B (a multiple of the 512-B group period), so rhsGapBytes /
// dstGapBytes (both 32B-aligned, < 512B) set the bank-group phase of each operand:
//   bank_group = (addr/32) % 16  (dav-2201; period = 512 B = 16 groups)
// lhs is always group 0; rhsGapBytes=256 -> group 8; dstGapBytes=128 -> group 4.

constexpr uint32_t kBlock = 1024;    // float elements per block
constexpr uint32_t kNumAdds = 16;    // number of independent adds

__global__ __vector__ void BankAddKernel(__gm__ float* lhsGm, __gm__ float* rhsGm, __gm__ float* outGm,
                                         uint32_t rhsGapBytes, uint32_t dstGapBytes)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> lhsG;
    AscendC::GlobalTensor<float> rhsG;
    AscendC::GlobalTensor<float> outG;
    lhsG.SetGlobalBuffer(lhsGm, kBlock);
    rhsG.SetGlobalBuffer(rhsGm, kBlock);
    outG.SetGlobalBuffer(outGm, kNumAdds * kBlock);

    const uint32_t rhsOff = (kBlock * sizeof(float) + rhsGapBytes);
    const uint32_t dstBase = (4 * kBlock * sizeof(float) + dstGapBytes);

    AscendC::LocalTensor<float> lhs(AscendC::TPosition::VECIN, 0, kBlock);
    AscendC::LocalTensor<float> rhs(AscendC::TPosition::VECIN, rhsOff, kBlock);
    AscendC::LocalTensor<float> dst[kNumAdds];
    for (uint32_t i = 0; i < kNumAdds; ++i) {
        dst[i] = AscendC::LocalTensor<float>(AscendC::TPosition::VECOUT,
                                             dstBase + i * kBlock * sizeof(float), kBlock);
    }

    AscendC::DataCopy(lhs, lhsG, kBlock);
    AscendC::DataCopy(rhs, rhsG, kBlock);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    for (uint32_t i = 0; i < kNumAdds; ++i) {
        AscendC::Add(dst[i], lhs, rhs, kBlock);
    }

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    for (uint32_t i = 0; i < kNumAdds; ++i) {
        AscendC::DataCopy(outG[i * kBlock], dst[i], kBlock);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main(int argc, char* argv[])
{
    // argv[1] = rhs gap in bytes, argv[2] = dst gap in bytes (both 32B-aligned, <512B).
    // "dense" -> 0 0.
    uint32_t rhsGapBytes = 0;
    uint32_t dstGapBytes = 0;
    if (argc > 1) {
        std::string arg = argv[1];
        if (arg != "dense") {
            rhsGapBytes = static_cast<uint32_t>(std::strtoul(arg.c_str(), nullptr, 0));
        }
    }
    if (argc > 2) {
        dstGapBytes = static_cast<uint32_t>(std::strtoul(argv[2], nullptr, 0));
    }
    if (rhsGapBytes % 32 != 0 || dstGapBytes % 32 != 0) {
        std::cerr << "bank_add: gaps must be multiples of 32 bytes (got " << rhsGapBytes << ", " << dstGapBytes
                  << ")\n";
        return 2;
    }

    try {
        constexpr size_t inBytes = kBlock * sizeof(float);
        constexpr size_t outBytes = kNumAdds * kBlock * sizeof(float);

        std::vector<float> lhs(kBlock);
        std::vector<float> rhs(kBlock);
        std::vector<float> out(kNumAdds * kBlock);
        std::vector<float> expected(kBlock);
        for (uint32_t i = 0; i < kBlock; ++i) {
            lhs[i] = 1.0f + static_cast<float>(i % 7) * 0.25f;
            rhs[i] = 1.0f + static_cast<float>(i % 5) * 0.5f;
            expected[i] = lhs[i] + rhs[i];
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        float* lhsDev = nullptr;
        float* rhsDev = nullptr;
        float* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&lhsDev), inBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&rhsDev), inBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), outBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(lhsDev, inBytes, lhs.data(), inBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(rhsDev, inBytes, rhs.data(), inBytes, ACL_MEMCPY_HOST_TO_DEVICE);

        BankAddKernel<<<1, 0, stream>>>(lhsDev, rhsDev, outDev, rhsGapBytes, dstGapBytes);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), outBytes, outDev, outBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t a = 0; a < kNumAdds && ok; ++a) {
            for (uint32_t i = 0; i < kBlock; ++i) {
                if (std::fabs(out[a * kBlock + i] - expected[i]) > 1.0e-4f) {
                    std::cerr << "bank_add rhs=" << rhsGapBytes << "B dst=" << dstGapBytes << "B mismatch: add " << a
                              << " elem " << i << " expected " << expected[i] << " got " << out[a * kBlock + i] << '\n';
                    ok = false;
                    break;
                }
            }
        }

        aclrtFree(lhsDev);
        aclrtFree(rhsDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "bank_add rhs=" << rhsGapBytes << "B dst=" << dstGapBytes << "B: " << (ok ? "PASS" : "FAIL")
                  << " (16 x " << kBlock << " float adds)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "bank_add: " << error.what() << '\n';
        return 1;
    }
}
