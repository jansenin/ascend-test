#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

// Divergent-branch benchmark (SIMD, RegBase low-level).
//
//   y = (x < threshold) ? expensive(x) : x
//
// where expensive(x) is kExpensiveK iterations of the bounded contraction
// e = e*0.5 + 0.5. The "rare" condition is true for ~1% of elements.
//
// SIMD has no per-lane branch: the expensive loop is executed for every
// 64-element vector (the mask only zeroes the non-rare lanes, it cannot skip
// the arithmetic), so a single rare element makes the whole vector pay the
// expensive cost.

constexpr uint32_t kLength = 4096;
constexpr float kThreshold = 0.01f;
constexpr uint32_t kExpensiveK = 64;

template <uint32_t Length>
__simd_vf__ inline void BranchVF(__ubuf__ float* in, __ubuf__ float* out)
{
    constexpr uint32_t elementsPerVector = AscendC::GetVecLen() / sizeof(float);
    uint32_t remaining = Length;
    for (uint32_t i = 0; i < Length; i += elementsPerVector) {
        AscendC::Reg::MaskReg mask = AscendC::Reg::UpdateMask<float>(remaining);
        AscendC::Reg::RegTensor<float> vr;
        AscendC::Reg::RegTensor<float> er;
        AscendC::Reg::RegTensor<float> tr;
        AscendC::Reg::MaskReg rare;
        AscendC::Reg::LoadAlign(vr, in + i);
        AscendC::Reg::Compares<float, AscendC::CMPMODE::LT>(rare, vr, kThreshold, mask);
        AscendC::Reg::Move(er, vr, mask);
        for (uint32_t k = 0; k < kExpensiveK; ++k) {
            AscendC::Reg::Muls(er, er, 0.5f, rare);
            AscendC::Reg::Adds(er, er, 0.5f, rare);
        }
        AscendC::Reg::Select(tr, er, vr, rare);
        AscendC::Reg::StoreAlign(out + i, tr, mask);
    }
}

__global__ __vector__ void BranchSimdKernel(__gm__ float* in, __gm__ float* out)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> inGm;
    AscendC::GlobalTensor<float> outGm;
    inGm.SetGlobalBuffer(in, kLength);
    outGm.SetGlobalBuffer(out, kLength);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    auto inLocal = allocator.Alloc<float, kLength>();
    auto outLocal = allocator.Alloc<float, kLength>();

    AscendC::DataCopy(inLocal, inGm, kLength);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    asc_vf_call<BranchVF<kLength>>(
        reinterpret_cast<__ubuf__ float*>(inLocal.GetPhyAddr()),
        reinterpret_cast<__ubuf__ float*>(outLocal.GetPhyAddr()));

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(outGm, outLocal, kLength);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main(int argc, char* argv[])
{
    (void)argc;
    (void)argv;

    try {
        constexpr size_t dataBytes = kLength * sizeof(float);
        std::vector<float> in(kLength);
        std::vector<float> out(kLength);
        std::vector<float> expected(kLength);

        // Deterministic input with ~1% of values below kThreshold.
        for (uint32_t i = 0; i < kLength; ++i) {
            in[i] = (i % 100 == 0) ? 0.001f : (0.5f + static_cast<float>(i % 97) * 0.25f);
            float e = in[i];
            for (uint32_t k = 0; k < kExpensiveK; ++k) {
                e = e * 0.5f + 0.5f;
            }
            expected[i] = (in[i] < kThreshold) ? e : in[i];
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        float* inDev = nullptr;
        float* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&inDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(inDev, dataBytes, in.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE);

        BranchSimdKernel<<<1, 0, stream>>>(inDev, outDev);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), dataBytes, outDev, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kLength; ++i) {
            if (out[i] != expected[i]) {
                std::cerr << "branch_simd mismatch at " << i << ": expected " << expected[i] << ", got "
                          << out[i] << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(inDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "branch_simd: " << (ok ? "PASS" : "FAIL") << " (" << kLength << " elems)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "branch_simd: " << error.what() << '\n';
        return 1;
    }
}
