#include <cmath>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/asc_fp16.h"
#include "half_utils.h"

constexpr uint32_t kLength = 4096;
constexpr uint32_t kThreads = 256;

// SIMT (dav-3510 only) half-precision version of the requested operation
// sequence. Each SIMT instruction still covers a 32-lane warp (32 halves),
// whereas the SIMD version covers 128 halves per register instruction.
__global__ void ArithSimtHalfKernel(half* a, half* b, half* out, uint64_t length)
{
    for (uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x; idx < length; idx += blockDim.x * gridDim.x) {
        half av = a[idx];
        half bv = b[idx];
        av += bv;   // a += b
        av = bv;    // a = b
        av /= bv;   // a /= b
        bv += av;   // b += a
        bv *= av;   // b *= a
        bv /= av;   // b /= a
        out[idx] = av + bv;
    }
}

int main()
{
    try {
        constexpr size_t bytes = kLength * sizeof(uint16_t);
        std::vector<uint16_t> a(kLength);
        std::vector<uint16_t> b(kLength);
        std::vector<uint16_t> out(kLength);
        std::vector<float> expected(kLength);
        for (uint32_t i = 0; i < kLength; ++i) {
            a[i] = lab::F16(1.0f + static_cast<float>(i % 10) * 0.1f);
            b[i] = lab::F16(1.0f + static_cast<float>(i % 7) * 0.5f);
            expected[i] = lab::F32(b[i]) + 2.0f;
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        half* aDev = nullptr;
        half* bDev = nullptr;
        half* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&aDev), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&bDev), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), bytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(aDev, bytes, a.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(bDev, bytes, b.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);

        ArithSimtHalfKernel<<<1, kThreads, 0, stream>>>(aDev, bDev, outDev, kLength);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), bytes, outDev, bytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kLength; ++i) {
            if (std::fabs(lab::F32(out[i]) - expected[i]) > 5.0e-2f) {
                std::cerr << "arith_simt_half mismatch at " << i << ": expected " << expected[i] << ", got "
                          << lab::F32(out[i]) << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(aDev);
        aclrtFree(bDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "arith_simt_half: " << (ok ? "PASS" : "FAIL") << " (" << kLength << " elements)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "arith_simt_half: " << error.what() << '\n';
        return 1;
    }
}
