#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <random>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

// Chained-scatter benchmark (SIMD, low-level vscatter basic API).
//
// The transpose of chained_gather: each level SCATTERS the previous level's
// buffer by a distinct permutation, so every level depends on the previous one:
//   a1 = scatter(chunk, perm0)
//   a2 = scatter(a1, perm1)
//   a3 = scatter(a2, perm2)
//   a4 = scatter(a3, perm3)   -> written to GM
//
// Four independent permutations (perm[l] = a bijection of 0..kChunk-1) are
// applied in sequence. Scatter with repeating indices is ill-defined (two
// threads would write the same slot), so only the permutation case exists.
// argv[1] = "perm"; argv[2] (optional) = repeat count (default 8).

constexpr uint32_t kChunk = 128;
constexpr uint32_t kNumChunks = 8;
constexpr uint32_t kTotal = kChunk * kNumChunks; // 1024 source elements
constexpr uint32_t kLevels = 4;

__global__ __vector__ void ChainedScatterSimdKernel(__gm__ float* src, __gm__ uint32_t* perm, __gm__ float* out, uint32_t repeats)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> srcGm;
    AscendC::GlobalTensor<uint32_t> permGm;
    AscendC::GlobalTensor<float> outGm;
    srcGm.SetGlobalBuffer(src, kTotal);
    permGm.SetGlobalBuffer(perm, kLevels * kChunk);
    outGm.SetGlobalBuffer(out, kTotal);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    auto srcLocal = allocator.Alloc<float, kTotal>();
    auto permLocal = allocator.Alloc<uint32_t, kLevels * kChunk>();
    auto a1 = allocator.Alloc<float, kChunk>();
    auto a2 = allocator.Alloc<float, kChunk>();
    auto a3 = allocator.Alloc<float, kChunk>();
    auto a4 = allocator.Alloc<float, kChunk>();

    // Load everything once: all chunks + the four permutation arrays.
    AscendC::DataCopy(srcLocal, srcGm, kTotal);
    AscendC::DataCopy(permLocal, permGm, kLevels * kChunk);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    for (uint32_t r = 0; r < repeats; ++r) {
        for (uint32_t c = 0; c < kNumChunks; ++c) {
            // Scatter offsets are BYTE addresses; permLocal stores perm[i]*sizeof(float).
            // Scatter's src has no base-offset param, so pass a sub-tensor view.
            AscendC::Scatter(a1, srcLocal[c * kChunk], permLocal[0 * kChunk], 0, kChunk);
            AscendC::Scatter(a2, a1, permLocal[1 * kChunk], 0, kChunk);
            AscendC::Scatter(a3, a2, permLocal[2 * kChunk], 0, kChunk);
            AscendC::Scatter(a4, a3, permLocal[3 * kChunk], 0, kChunk);

            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::DataCopy(outGm[c * kChunk], a4, kChunk);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main(int argc, char* argv[])
{
    std::string variant = (argc > 1) ? argv[1] : "perm";
    if (variant != "perm") {
        std::cerr << "chained_scatter_simd: variant must be 'perm' (repeats are ill-defined for scatter)\n";
        return 2;
    }
    uint32_t repeats = 8;
    if (argc > 2) {
        repeats = static_cast<uint32_t>(std::strtoul(argv[2], nullptr, 10));
        if (repeats == 0) repeats = 1;
    }

    try {
        constexpr size_t dataBytes = kTotal * sizeof(float);
        constexpr size_t permBytes = kLevels * kChunk * sizeof(uint32_t);
        std::vector<float> src(kTotal);
        std::vector<uint32_t> perm(kLevels * kChunk);     // element index perm[l*kChunk+i]
        std::vector<uint32_t> bytePerm(kLevels * kChunk); // device scatter offset (BYTE address)
        std::vector<float> out(kTotal);
        std::vector<float> expected(kTotal);

        for (uint32_t i = 0; i < kTotal; ++i) {
            src[i] = 0.5f + static_cast<float>(i % 97) * 0.25f;
        }
        std::mt19937 gen(42);
        for (uint32_t l = 0; l < kLevels; ++l) {
            for (uint32_t i = 0; i < kChunk; ++i) {
                perm[l * kChunk + i] = i;
            }
            std::shuffle(perm.begin() + l * kChunk, perm.begin() + (l + 1) * kChunk, gen);
        }
        for (uint32_t i = 0; i < kLevels * kChunk; ++i) {
            bytePerm[i] = perm[i] * sizeof(float);
        }

        // Expected: compose the four permutations, then scatter each chunk.
        for (uint32_t c = 0; c < kNumChunks; ++c) {
            for (uint32_t i = 0; i < kChunk; ++i) {
                uint32_t e = i;
                for (uint32_t l = 0; l < kLevels; ++l) {
                    e = perm[l * kChunk + e];
                }
                expected[c * kChunk + e] = src[c * kChunk + i];
            }
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        float* srcDev = nullptr;
        uint32_t* permDev = nullptr;
        float* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&srcDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&permDev), permBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), dataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(srcDev, dataBytes, src.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(permDev, permBytes, bytePerm.data(), permBytes, ACL_MEMCPY_HOST_TO_DEVICE);

        ChainedScatterSimdKernel<<<1, 0, stream>>>(srcDev, permDev, outDev, repeats);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), dataBytes, outDev, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kTotal; ++i) {
            if (out[i] != expected[i]) {
                std::cerr << "chained_scatter_simd[" << variant << "] mismatch at " << i << ": expected "
                          << expected[i] << ", got " << out[i] << '\n';
                ok = false;
                break;
            }
        }

        aclrtFree(srcDev);
        aclrtFree(permDev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "chained_scatter_simd[" << variant << "]: " << (ok ? "PASS" : "FAIL") << " (" << kTotal
                  << " elems x " << kLevels << " levels)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "chained_scatter_simd: " << error.what() << '\n';
        return 1;
    }
}
