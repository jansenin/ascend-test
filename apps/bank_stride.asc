#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

// Strided UB bank-conflict microbenchmark (the doc's canonical conflict shape).
//
// One Add per "repeat" via BinaryRepeatParams: mask = 64 fp32 elements (= 256 B =
// 8 DataBlocks of 32 B), repeatTime = 1, src0BlkStride/src1BlkStride = s (in
// DataBlock = 32 B units). The stride between the 8 DataBlocks of a repeat
// determines how many bank groups they span:
//   s=1  -> 8 consecutive DataBlocks -> 8 consecutive groups -> 1 beat  (no conflict)
//   s=8  -> blocks land in 2 groups  -> 4 beats
//   s=16 -> all 8 blocks in ONE group -> 8 beats (full read-read/write-write conflict)
// (dav-2201 group period = 16 DataBlocks = 512 B; see avoid_bank_conflict_npu_arch_2201.md)
//
// The 16 Adds read the SAME src0/src1 and write 16 distinct contiguous dst blocks,
// so the only thing that varies is the block stride `s`.

constexpr uint32_t kMask = 64;                    // fp32 elems per repeat = 8 DataBlocks
constexpr uint32_t kNumAdds = 16;
constexpr uint32_t kSrcElems = 1024;              // 4 KB; block7 at s=16 lands at 7*16*8+8 = 904 < 1024
constexpr uint32_t kDstElems = kNumAdds * kMask;  // 1024

__global__ __vector__ void BankStrideKernel(__gm__ float* src0Gm, __gm__ float* src1Gm, __gm__ float* outGm,
                                            uint8_t blkStride)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> src0G;
    AscendC::GlobalTensor<float> src1G;
    AscendC::GlobalTensor<float> outG;
    src0G.SetGlobalBuffer(src0Gm, kSrcElems);
    src1G.SetGlobalBuffer(src1Gm, kSrcElems);
    outG.SetGlobalBuffer(outGm, kDstElems);

    AscendC::LocalTensor<float> src0(AscendC::TPosition::VECIN, 0, kSrcElems);
    AscendC::LocalTensor<float> src1(AscendC::TPosition::VECIN, kSrcElems * sizeof(float), kSrcElems);
    AscendC::LocalTensor<float> dst(AscendC::TPosition::VECOUT, 2 * kSrcElems * sizeof(float), kDstElems);

    AscendC::DataCopy(src0, src0G, kSrcElems);
    AscendC::DataCopy(src1, src1G, kSrcElems);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::BinaryRepeatParams params;
    params.dstBlkStride = 1;
    params.src0BlkStride = blkStride;
    params.src1BlkStride = blkStride;

    for (uint32_t i = 0; i < kNumAdds; ++i) {
        AscendC::Add(dst[i * kMask], src0, src1, static_cast<uint64_t>(kMask), 1, params);
    }

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(outG, dst, kDstElems);
    AscendC::PipeBarrier<PIPE_ALL>();
}

int main(int argc, char* argv[])
{
    // First argument = block stride in DataBlock (32 B) units: 1, 2, 4, 8, 16.
    uint8_t blkStride = 1;
    if (argc > 1) {
        blkStride = static_cast<uint8_t>(std::strtoul(argv[1], nullptr, 0));
    }
    if (blkStride == 0) {
        blkStride = 1;
    }

    try {
        std::vector<float> src0(kSrcElems);
        std::vector<float> src1(kSrcElems);
        std::vector<float> out(kDstElems);
        std::vector<float> expected(kDstElems);
        for (uint32_t i = 0; i < kSrcElems; ++i) {
            src0[i] = 1.0f + static_cast<float>(i % 7) * 0.25f;
            src1[i] = 1.0f + static_cast<float>(i % 5) * 0.5f;
        }
        // For repeat i, DataBlock b (b in 0..7), element e (0..7):
        //   src index = b*s*8 + e (8 floats per 32-B DataBlock, stride s DataBlocks)
        //   dst index = i*64 + b*8 + e
        for (uint32_t i = 0; i < kNumAdds; ++i) {
            for (uint32_t b = 0; b < 8; ++b) {
                for (uint32_t e = 0; e < 8; ++e) {
                    uint32_t si = b * blkStride * 8 + e;
                    uint32_t di = i * kMask + b * 8 + e;
                    expected[di] = src0[si] + src1[si];
                }
            }
        }

        if (aclInit(nullptr) != ACL_SUCCESS) throw std::runtime_error("aclInit failed");
        if (aclrtSetDevice(0) != ACL_SUCCESS) throw std::runtime_error("aclrtSetDevice failed");
        aclrtStream stream = nullptr;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) throw std::runtime_error("aclrtCreateStream failed");

        float* src0Dev = nullptr;
        float* src1Dev = nullptr;
        float* outDev = nullptr;
        aclrtMalloc(reinterpret_cast<void**>(&src0Dev), kSrcElems * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&src1Dev), kSrcElems * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(reinterpret_cast<void**>(&outDev), kDstElems * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(src0Dev, kSrcElems * sizeof(float), src0.data(), kSrcElems * sizeof(float),
                    ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(src1Dev, kSrcElems * sizeof(float), src1.data(), kSrcElems * sizeof(float),
                    ACL_MEMCPY_HOST_TO_DEVICE);

        BankStrideKernel<<<1, 0, stream>>>(src0Dev, src1Dev, outDev, blkStride);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(out.data(), kDstElems * sizeof(float), outDev, kDstElems * sizeof(float),
                    ACL_MEMCPY_DEVICE_TO_HOST);

        bool ok = true;
        for (uint32_t i = 0; i < kDstElems && ok; ++i) {
            if (std::fabs(out[i] - expected[i]) > 1.0e-4f) {
                std::cerr << "bank_stride s=" << static_cast<int>(blkStride) << " mismatch at " << i << " expected "
                          << expected[i] << " got " << out[i] << '\n';
                ok = false;
            }
        }

        aclrtFree(src0Dev);
        aclrtFree(src1Dev);
        aclrtFree(outDev);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();

        std::cout << "bank_stride s=" << static_cast<int>(blkStride) << ": " << (ok ? "PASS" : "FAIL") << " (16 adds, "
                  << kMask << " fp32/repeat)\n";
        return ok ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "bank_stride: " << error.what() << '\n';
        return 1;
    }
}
