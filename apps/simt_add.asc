// Self-contained SIMT (single-instruction, multiple-thread) add for dav-3510 (Ascend 950).
// Demonstrates the CUDA-like programming model: threadIdx/blockIdx/blockDim/gridDim,
// raw global-memory pointers, and the 4-argument <<<blocks, threads, dynUb, stream>>> launch.

#include <cmath>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

constexpr uint32_t kSimtLength = 8192;
constexpr uint32_t kSimtThreads = 256;
constexpr uint32_t kSimtBlocks = kSimtLength / kSimtThreads;

__global__ void SimtAddKernel(float* x, float* y, float* z, uint64_t length)
{
    const uint64_t idx = static_cast<uint64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
    if (idx < length) {
        z[idx] = x[idx] + y[idx];
    }
}

static void CheckAcl(aclError status, const char* op)
{
    if (status != ACL_SUCCESS) {
        throw std::runtime_error(std::string(op) + " failed: " + std::to_string(status));
    }
}

int main()
{
    try {
        constexpr size_t bytes = kSimtLength * sizeof(float);
        std::vector<float> xHost(kSimtLength);
        std::vector<float> yHost(kSimtLength);
        std::vector<float> zHost(kSimtLength);
        for (uint32_t i = 0; i < kSimtLength; ++i) {
            xHost[i] = static_cast<float>(static_cast<int>(i % 17) - 8) * 0.5f;
            yHost[i] = static_cast<float>(static_cast<int>((i * 7) % 11) - 5) * 0.25f;
        }

        CheckAcl(aclInit(nullptr), "aclInit");
        CheckAcl(aclrtSetDevice(0), "aclrtSetDevice");
        aclrtStream stream = nullptr;
        CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");

        float* xDevice = nullptr;
        float* yDevice = nullptr;
        float* zDevice = nullptr;
        CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&xDevice), bytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc x");
        CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&yDevice), bytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc y");
        CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&zDevice), bytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc z");
        CheckAcl(aclrtMemcpy(xDevice, bytes, xHost.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy x");
        CheckAcl(aclrtMemcpy(yDevice, bytes, yHost.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy y");

        SimtAddKernel<<<kSimtBlocks, kSimtThreads, 0, stream>>>(xDevice, yDevice, zDevice, kSimtLength);
        CheckAcl(aclrtSynchronizeStream(stream), "sync");

        CheckAcl(aclrtMemcpy(zHost.data(), bytes, zDevice, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy z");

        bool pass = true;
        for (uint32_t i = 0; i < kSimtLength; ++i) {
            const float expected = xHost[i] + yHost[i];
            if (std::fabs(zHost[i] - expected) > 1.0e-4f) {
                std::cerr << "simt_add mismatch at " << i << ": expected " << expected << ", got " << zHost[i] << '\n';
                pass = false;
                break;
            }
        }

        CheckAcl(aclrtFree(xDevice), "free x");
        CheckAcl(aclrtFree(yDevice), "free y");
        CheckAcl(aclrtFree(zDevice), "free z");
        CheckAcl(aclrtDestroyStream(stream), "destroy stream");
        CheckAcl(aclrtResetDevice(0), "reset device");
        CheckAcl(aclFinalize(), "finalize");

        std::cout << "simt_add: " << (pass ? "PASS" : "FAIL") << " (" << kSimtLength << " elements)\n";
        return pass ? 0 : 1;
    } catch (const std::exception& e) {
        std::cerr << "simt_add: " << e.what() << '\n';
        return 1;
    }
}
