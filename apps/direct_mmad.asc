#include "device_kernels.h"
#include "test_support.h"

int main()
{
    try {
        constexpr size_t aCount = lab::kM * lab::kK;
        constexpr size_t bCount = lab::kK * lab::kN;
        constexpr size_t cCount = lab::kM * lab::kN;
        auto a = lab::MakeInput(aCount, 3);
        auto b = lab::MakeRectangularIdentity();
        std::vector<aclFloat16> c(cCount);
        std::vector<float> expected(cCount, 0.0f);
        for (uint32_t row = 0; row < lab::kM; ++row) {
            for (uint32_t col = 0; col < lab::kK; ++col) {
                expected[row * lab::kN + col] = lab::Float(a[row * lab::kK + col]);
            }
        }

        lab::Runtime runtime;
        lab::DeviceBuffer aDevice(aCount * sizeof(aclFloat16));
        lab::DeviceBuffer bDevice(bCount * sizeof(aclFloat16));
        lab::DeviceBuffer cDevice(cCount * sizeof(aclFloat16));
        aDevice.CopyFrom(a.data());
        bDevice.CopyFrom(b.data());
        lab::MmadKernel<lab::kM, lab::kK, lab::kN, lab::kSingleCoreM, lab::kBaseM, lab::kBaseK, lab::kBaseN>
            <<<lab::kM / lab::kSingleCoreM, 0, runtime.stream()>>>(aDevice.data(), bDevice.data(), cDevice.data());
        runtime.Sync();
        cDevice.CopyTo(c.data());
        return lab::Verify(c, expected, 2.0e-2f, "direct_mmad") ? 0 : 1;
    } catch (const std::exception& error) {
        std::cerr << "direct_mmad: " << error.what() << '\n';
        return 1;
    }
}
